{
  "version": 2,
  "builds": [
    {
      "src": "api/fetch-news.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/fetch-news",
      "dest": "api/fetch-news.py"
    }
  ],
  "crons": [
    {
      "path": "/api/fetch-news",
      "schedule": "0 * * * *"
    }
  ]
}
